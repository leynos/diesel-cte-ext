{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    // Changelog release sections legitimately repeat headings such as
    // "Changed" and "Fixed"; only flag duplicates that share a parent.
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" }
  },
  "ignores": ["**/.venv/**", ".node_modules/**", "**/node_modules/**", "**/target/**"]
}
